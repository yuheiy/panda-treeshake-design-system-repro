{
  "name": "@repro/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run css:treeshake && pnpm run css:full",
    "css:treeshake": "panda cssgen --config panda.true.config.js --outfile true.css",
    "css:full": "panda cssgen --config panda.false.config.js --outfile false.css"
  },
  "dependencies": {
    "@repro/ds": "workspace:*",
    "@repro/icons": "workspace:*"
  },
  "devDependencies": {
    "@pandacss/dev": "2.0.0-beta.18"
  }
}
